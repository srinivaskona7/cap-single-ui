{
  "xsappname": "single-{{ .Release.Namespace }}",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.kymacapnodejsviewer",
      "description": "Access Books data"
    }
  ],

  "attributes": [],

  "authorities": [
    "$ACCEPT_GRANTED_AUTHORITIES",
    "$XSAPPNAME.kymacapnodejsviewer"
  ],

  "role-templates": [
    {
      "name": "KymaCapNodeJsDemoRoleTemplate",
      "description": "Role Template for accessing Books",
      "scope-references": [
        "$XSAPPNAME.kymacapnodejsviewer"
      ],
      "attribute-references": []
    }
  ],

  "role-collections": [
    {
      "name": "CAPNodeJsUserRC",
      "description": "Role Collection for Kyma CAP Node.js App",
      "role-template-references": [
        "$XSAPPNAME.KymaCapNodeJsDemoRoleTemplate"
      ]
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": [
      "https://single-approuter-default.c-35d9992.kyma.ondemand.com/**"
    ]
  }
}
