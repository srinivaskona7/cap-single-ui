{
  "xsappname": "single-ui-{{ .Release.Namespace }}",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.kymacapnodejsviewer1",
      "description": "Access Books data"
    },
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Admin access for Books"
    }
  ],

  "attributes": [],

  "authorities": [
    "$ACCEPT_GRANTED_AUTHORITIES",
    "$XSAPPNAME.kymacapnodejsviewer1",
    "$XSAPPNAME.Admin"
  ],

  "role-templates": [
    {
      "name": "KymaCapNodeJsDemoRoleTemplate1",
      "description": "Role Template for accessing Books",
      "scope-references": ["$XSAPPNAME.kymacapnodejsviewer1"],
      "attribute-references": []
    },
    {
      "name": "AdminRoleTemplate",
      "description": "Admin Role Template for Books",
      "scope-references": ["$XSAPPNAME.Admin"],
      "attribute-references": []
    }
  ],

  "role-collections": [
    {
      "name": "CAPNodeJsUserRC1",
      "description": "Role Collection for Kyma CAP Node.js App",
      "role-template-references": ["$XSAPPNAME.KymaCapNodeJsDemoRoleTemplate1"]
    },
    {
      "name": "CAPNodeJsAdminRC",
      "description": "Admin Role Collection",
      "role-template-references": ["$XSAPPNAME.AdminRoleTemplate"]
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": [
      "https://single-ui-approuter-kyma-nodejs-demo.c-9d0a141.kyma.ondemand.com/**"
    ]
  }
}
